  "info": {
    "title": "FastAPI Nuxt API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health-check/": {
      "get": {
        "description": "Liveness probe; database readiness is checked by the prestart service.",
        "operationId": "health_health_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Health Health Check",
                  "type": "integer"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": ["health"]
      }
    },
    "/login/claim": {
      "post": {
        "description": "Second step of a 'magic link' login. The user provides the emailed token\nin the Authorization header and the client-side token in the request body.",
        "operationId": "login_validate_magic_link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebToken"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Validate Magic Link",
        "tags": ["login"]
      }
    },
    "/login/confirm-email": {
      "get": {
        "description": "Confirm the user's email address using a token received via email.",
        "operationId": "login_confirm_email",
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Msg"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Email",
        "tags": ["login"]
      }
    },
    "/login/logout-all": {
      "post": {
        "operationId": "login_logout_all",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Msg"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Logout All",
        "tags": ["login"]
      }
    },
    "/login/magic/{email}": {
      "post": {
        "description": "First step of a 'magic link' login. Generates two tokens: one for the\nemail link and one for the client to claim later. Creates the user if\nthey don't exist and registration is open.",
        "operationId": "login_login_with_magic_link",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login With Magic Link",
        "tags": ["login"]
      }
    },
    "/login/new-totp": {
      "post": {
        "description": "Request new keys to enable TOTP on the user account.",
        "operationId": "login_request_new_totp",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewTOTPResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Request New Totp",
        "tags": ["login"]
      }
    },
    "/login/oauth": {
      "post": {
        "description": "Standard OAuth2 compatible token login.",
        "operationId": "login_login_with_oauth2",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_login_with_oauth2"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login With Oauth2",
        "tags": ["login"]
      }
    },
    "/login/reauth": {
      "post": {
        "operationId": "login_reauthenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reauthentication"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Reauthenticate",
        "tags": ["login"]
      }
    },
    "/login/recover/{email}": {
      "post": {
        "description": "Initiate password recovery. If the user exists and is active, an email\nis sent with a recovery link.",
        "operationId": "login_recover_password",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recover Password",
        "tags": ["login"]
      }
    },
    "/login/refresh": {
      "post": {
        "description": "Get a new access and refresh token. The provided refresh token is\nrevoked upon use.",
        "operationId": "login_refresh_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Refresh Token",
        "tags": ["login"]
      }
    },
    "/login/reset": {
      "post": {
        "description": "Final step of password recovery. The user provides the recovery token from\nthe email header and the client-side token from the body.",
        "operationId": "login_reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_reset_password"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Msg"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Reset Password",
        "tags": ["login"]
      }
    },
    "/login/revoke": {
      "post": {
        "description": "Revoke a refresh token",
        "operationId": "login_revoke_refresh_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Msg"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Revoke Refresh Token",
        "tags": ["login"]
      }
    },
    "/login/signup": {
      "post": {
        "description": "Create a new user without needing to be logged in.",
        "operationId": "login_create_user_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomUserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CustomUserRead"
                    },
                    {
                      "$ref": "#/components/schemas/Msg"
                    }
                  ],
                  "title": "Response Login Create User Profile"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create User Profile",
        "tags": ["login"]
      }
    },
    "/login/totp": {
      "delete": {
        "description": "Disable TOTP.",
        "operationId": "login_disable_totp_authentication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomUserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityChangeResponse"
                }
