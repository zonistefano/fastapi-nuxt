# Generated secrets are local to each project. Run make init before starting.
PROJECT_NAME=FastAPI Nuxt
FRONTEND_HOST=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENABLE_DOCS=true
# Use a shared Redis URL before running multiple API workers/replicas.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS_URL=redis://queue:6379/2
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=
SECRET_KEY=
TOTP_SECRET_KEY=
REQUIRE_EMAIL_VALIDATION=false
USERS_OPEN_REGISTRATION=true
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=FastAPI Nuxt
EMAILS_TO_EMAIL=admin@example.com
SMTP_TLS=false
SMTP_SSL=false
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SERVER_BOT=Assistant
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
FLOWER_USER=admin
FLOWER_PASSWORD=
NUXT_PUBLIC_APP_NAME=FastAPI Nuxt
NUXT_PUBLIC_API_URL=http://localhost:8000
NUXT_PUBLIC_API_WS=ws://localhost:8000
NUXT_OG_IMAGE_SECRET=
# Set both values to explicitly enable your own analytics instance.
NUXT_UMAMI_ID=
NUXT_UMAMI_HOST=
# Optional registry prefix for deployment, e.g. ghcr.io/your-organization.
IMAGE_PREFIX=local
TAG=dev
